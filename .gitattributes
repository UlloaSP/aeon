# git autocrlf=true converts LF to CRLF on Windows, which breaks rustfmt --check in CI.
* text=auto eol=lf
# Batch files need CRLF for cmd.exe to parse them reliably.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ico binary
# Captured terminal output: its CRLFs are what the parser is tested on.
*.bin binary
*.msi binary
Cargo.lock linguist-generated
